#
# docker-login-aws-ecr-public - Login to AWS ECR Public with IAM access keys
#
# Usage: docker-login-aws-ecr-public <secret-method> <registry> <access-key-id-secret> <secret-access-key-secret>
#
# Arguments:
#   secret-method            - Secret retrieval method (github, env)
#   registry                 - ECR Public registry (public.ecr.aws)
#   access-key-id-secret     - Name of secret containing AWS access key ID
#   secret-access-key-secret - Name of secret containing AWS secret access key
#
# ECR Public only issues auth tokens from us-east-1, regardless of where the caller runs.
#
set -euo pipefail

# shellcheck source=src/scripts/defaults/platform.bash
source "$(dirname "${BASH_SOURCE[0]}")/../../defaults/platform.bash"
# shellcheck source=src/scripts/lib/log.bash
source "$(dirname "${BASH_SOURCE[0]}")/../../lib/log.bash"
# shellcheck source=src/scripts/defaults/docker-common.bash
source "$(dirname "${BASH_SOURCE[0]}")/../../defaults/docker-common.bash"

SCRIPT_DIR="$(dirname "${0}")"
PLUGINS_DIR="${SCRIPT_DIR}/.."

secret_method="${1}"
registry="${2}"
access_key_id_secret="${3}"
secret_access_key_secret="${4}"

get_secret="${PLUGINS_DIR}/secret-value-providers/get-secret-${secret_method}"

access_key_id=$("${get_secret}" "${access_key_id_secret}") || exit 1
secret_access_key=$("${get_secret}" "${secret_access_key_secret}") || exit 1

log "Logging in to AWS ECR Public ${registry}..."

export AWS_ACCESS_KEY_ID="${access_key_id}"
export AWS_SECRET_ACCESS_KEY="${secret_access_key}"
export AWS_DEFAULT_REGION="us-east-1"

aws ecr-public get-login-password --region us-east-1 | ${IMAGE_BUILD_COMMAND} login --username AWS --password-stdin "${registry}"
