#
# docker-platform-setup - Validates docker platform and installs QEMU on Linux CI
#
# Validates DOCKER_PLATFORM against allowed values and registers QEMU binfmt
# handlers on Linux build servers, from the kaptain binfmt image, for any target
# platform that is not native to the host. On local Linux machines it only warns.
#
# Inputs (environment variables):
#   DOCKER_PLATFORM    - Target platform (from docker-common.bash default or input)
#   IMAGE_BUILD_COMMAND - Container runtime (from validate-tooling)
#   BUILD_MODE         - "local" or "build_server" (from build-mode.bash default)
#
set -euo pipefail

SCRIPT_DIR="$(dirname "${0}")"

# shellcheck source=src/scripts/defaults/platform.bash
source "${SCRIPT_DIR}/../defaults/platform.bash"
# shellcheck source=src/scripts/lib/log.bash
source "${SCRIPT_DIR}/../lib/log.bash"
# shellcheck source=src/scripts/defaults/docker-common.bash
source "${SCRIPT_DIR}/../defaults/docker-common.bash"
# shellcheck source=src/scripts/defaults/build-mode.bash
source "${SCRIPT_DIR}/../defaults/build-mode.bash"

log "=== Docker Platform Setup ==="
log "Platform: ${DOCKER_PLATFORM}"
log "Build mode: ${BUILD_MODE}"
log "============================="

# Validate platform value
#
# linux/386 is single-platform only. It exists for legacy 32 bit toolchains that
# were never packaged for anything else, and there is no manifest list pairing
# for it, so it is deliberately absent from the comma separated combinations.
case "${DOCKER_PLATFORM}" in
  linux/amd64) ;;
  linux/arm64) ;;
  linux/386) ;;
  linux/amd64,linux/arm64) ;;
  linux/arm64,linux/amd64) ;;
  *)
    log_error "Invalid DOCKER_PLATFORM value '${DOCKER_PLATFORM}' - must be: linux/amd64, linux/arm64, linux/386, or amd64 and arm64 comma-separated"
    exit 1
    ;;
esac

log "Platform validated: ${DOCKER_PLATFORM}"

# List the target arches (binfmt names) this host cannot run natively.
# linux/386 runs natively on amd64 kernels. An unrecognised host arch is
# treated as needing emulation for everything, to stay on the safe side.
foreign_arches() {
  local host_arch platform arch
  case "$(uname -m)" in
    x86_64|amd64) host_arch="amd64" ;;
    aarch64|arm64) host_arch="arm64" ;;
    *) host_arch="unknown" ;;
  esac

  for platform in ${DOCKER_PLATFORM//,/ }; do
    arch="${platform#linux/}"
    case "${host_arch}:${arch}" in
      amd64:amd64|amd64:386|arm64:arm64) ;;
      *) echo "${arch}" ;;
    esac
  done
}

# Kernel binfmt_misc handler name the binfmt image registers for each arch
binfmt_handler() {
  case "${1}" in
    amd64) echo "qemu-x86_64" ;;
    arm64) echo "qemu-aarch64" ;;
    386) echo "qemu-i386" ;;
  esac
}

# Set up QEMU binfmt handlers on Linux, only for arches that need emulation and
# are not already registered. Build servers get them installed from the binfmt
# image. Local machines are the user's to configure, so only a warning there.
if [[ "$(uname -s)" != "Linux" ]]; then
  log "Not a Linux host: skipping QEMU setup"
else
  needed=$(foreign_arches)
  if [[ -z "${needed}" ]]; then
    log "Host arch $(uname -m) builds ${DOCKER_PLATFORM} natively: skipping QEMU setup"
  else
    binfmt_misc_dir="${BINFMT_MISC_DIR:-/proc/sys/fs/binfmt_misc}"
    missing=""
    for arch in ${needed}; do
      if [[ ! -e "${binfmt_misc_dir}/$(binfmt_handler "${arch}")" ]]; then
        missing="${missing:+${missing},}${arch}"
      fi
    done

    binfmt_image="${QEMU_BINFMT_IMAGE:-ghcr.io/kube-kaptain/image/image-binfmt:10.2.3.1}"
    if [[ -z "${missing}" ]]; then
      log "QEMU binfmt already registered for $(echo "${needed}" | paste -sd, -): skipping install"
    elif [[ "${BUILD_MODE}" != "build_server" ]]; then
      log_warning "QEMU binfmt not registered for ${missing}: builds for those arches will fail with 'exec format error'"
      log_warning "Set it up yourself, for example: sudo ${IMAGE_BUILD_COMMAND} run --privileged --rm ${binfmt_image} --install ${missing}"
    else
      log "Installing QEMU binfmt support for ${missing} from ${binfmt_image}..."
      # Registering binfmt handlers needs root. Rootless podman gets it through sudo.
      installed_from_image=true
      if [[ "${IMAGE_BUILD_COMMAND}" == "podman" ]]; then
        sudo "${IMAGE_BUILD_COMMAND}" run --privileged --rm "${binfmt_image}" --install "${missing}" || installed_from_image=false
      else
        # No sudo: the docker daemon already runs as root and does the work
        ${IMAGE_BUILD_COMMAND} run --privileged --rm "${binfmt_image}" --install "${missing}" || installed_from_image=false
      fi
      if [[ "${installed_from_image}" != "true" ]]; then
        log_warning "Installing QEMU binfmt support from ${binfmt_image} failed: falling back to the OS package manager"
        if command -v apt-get &>/dev/null; then
          sudo apt-get update
          sudo apt-get install -y qemu-user-static binfmt-support
        elif command -v yum &>/dev/null; then
          sudo yum install -y qemu-user-static
        else
          log_error "No supported package manager found (need apt-get or yum)"
          exit 1
        fi
      fi
      log "QEMU binfmt support installed for ${missing}"
    fi
  fi
fi

log "Docker platform setup complete"
