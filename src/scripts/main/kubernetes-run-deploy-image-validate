# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# kubernetes-run-deploy-image-validate: run the built deploy image's own
# validate-environment against its baked env-var contract.
#
# Runs after all building so a failure here points at the built image. A
# bare run checks what will ship, so a pass means the image cannot boot with
# a broken contract at deploy time.
#
# Multi-arch: the base URI is a manifest list and may not run locally, so the
# per-arch tag matching the host runs natively, or the first configured
# platform under emulation.
#
# Inputs (env):
#   RUN_DEPLOY_IMAGE_URI  - required; from kubernetes-run-package
#   IMAGE_BUILD_COMMAND   - required; docker | podman
#   DOCKER_PLATFORM       - built platform(s) (default linux/amd64)
#
# Outputs: none; exit status only.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=src/scripts/defaults/platform.bash
source "${SCRIPT_DIR}/../defaults/platform.bash"
# shellcheck source=src/scripts/lib/log.bash
source "${SCRIPT_DIR}/../lib/log.bash"
# shellcheck source=src/scripts/defaults/docker-common.bash
source "${SCRIPT_DIR}/../defaults/docker-common.bash"

RUN_DEPLOY_IMAGE_URI="${RUN_DEPLOY_IMAGE_URI:?RUN_DEPLOY_IMAGE_URI is required (from kubernetes-run-package)}"
IMAGE_BUILD_COMMAND="${IMAGE_BUILD_COMMAND:?IMAGE_BUILD_COMMAND is required}"

host_platform() {
  case "$(uname -m)" in
    arm64|aarch64)  echo "linux/arm64" ;;
    x86_64|amd64)   echo "linux/amd64" ;;
    *)              echo "" ;;
  esac
}

main() {
  log "=== Kubernetes Run Deploy Image Validate ==="
  log "Image:     ${RUN_DEPLOY_IMAGE_URI}"
  log "Platforms: ${DOCKER_PLATFORM}"
  log "============================================"

  local run_uri="${RUN_DEPLOY_IMAGE_URI}"
  local platform_args=()
  if [[ "${DOCKER_PLATFORM}" == *,* ]]; then
    local platforms platform chosen=""
    IFS=',' read -ra platforms <<< "${DOCKER_PLATFORM}"
    local host
    host=$(host_platform)
    for platform in "${platforms[@]}"; do
      if [[ "${platform}" == "${host}" ]]; then
        chosen="${platform}"
        break
      fi
    done
    if [[ -z "${chosen}" ]]; then
      chosen="${platforms[0]}"
      log "Host arch ($(uname -m)) not among the configured platforms;"
      log "validating the ${chosen} image under emulation."
    fi
    run_uri="${RUN_DEPLOY_IMAGE_URI}-${chosen//\//-}"
    platform_args=(--platform "${chosen}")
  fi

  log ""
  log "Running the image's baked validate-environment (${run_uri})..."
  log ""
  "${IMAGE_BUILD_COMMAND}" run --rm "${platform_args[@]+"${platform_args[@]}"}" \
    "${run_uri}" validate-environment

  log ""
  log "Deploy image validated: the baked env-var contract passes its own gate."
}

main "$@"
