#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# helm-render-and-process - Fetches a helm chart, renders it, and processes the
# output into clean individual kubernetes manifests.
#
# Stages:
#   A-chart/          fetched chart source
#   B-rendered/       helm template output (preserves chart subdirs)
#   C-split/          multi-doc split in place, one resource per file
#   D-moved-files/    only moveFiles kept, renamed as specified
#   E-sed-replaced/   sed replacements applied
#   F-yq-transformed/ yq transforms (inline + file-based)
#   G-annotated/      kaptain labels/annotations injected
#   H-validated/      yq validation passed
#
set -euo pipefail

SCRIPT_DIR="$(dirname "${0}")"

# shellcheck source=src/scripts/defaults/platform.bash
source "${SCRIPT_DIR}/../defaults/platform.bash"
# shellcheck source=src/scripts/lib/log.bash
source "${SCRIPT_DIR}/../lib/log.bash"
# shellcheck source=src/scripts/lib/output-var.bash
source "${SCRIPT_DIR}/../lib/output-var.bash"
# shellcheck source=src/scripts/lib/token-format.bash
source "${SCRIPT_DIR}/../lib/token-format.bash"
# shellcheck source=src/scripts/defaults/tokens.bash
source "${SCRIPT_DIR}/../defaults/tokens.bash"

# Sentinel passed as helm's --namespace so .Release.Namespace gets a stable,
# ASCII-only string with no `${...}` characters. Helm stamps this into every
# field that references .Release.Namespace (.metadata.namespace, subjects[].namespace,
# secretKeyRef.namespace, webhook clientConfig.service.namespace, etc.). Stage 7
# swaps it for the project's correctly-styled environment token. Avoids the
# helm/mustache vs shell-style token clash that would occur if we passed
# `${Environment}` (or any `${...}` form) directly to helm. Lowercase,
# hyphenated and short because charts also template .Release.Namespace into
# resource names, where their name helpers `| lower` it, sanitise underscores
# and `| trunc 63` - any of which would leave a fragment the sweep cannot match.
readonly NAMESPACE_PLACEHOLDER="kaptain-namespace-placeholder"

# Sentinel passed as fullnameOverride, swapped for the project-name token by the
# same stage 7 sweep and for the same reasons: passing `${ProjectName}` to helm
# would hardcode one token style, and a mustache-styled project would have helm
# evaluate its own delimiters. Rendering the name as a token rather than the
# resolved project name keeps the packaged manifests portable and leaves charts
# that already tokenise their names (via nameOverride) byte-identical.
readonly FULLNAME_PLACEHOLDER="kaptain-fullname-placeholder"

# Required inputs
OUTPUT_SUB_PATH="${OUTPUT_SUB_PATH:?OUTPUT_SUB_PATH is required}"

# Chart source - exactly one mode must be configured
REPO_URL="${VENDOR_HELM_RENDERED_REPO_URL:-}"
REPO_NAME="${PROJECT_NAME:-}"
CHART_NAME="${VENDOR_HELM_RENDERED_CHART_NAME:-}"
OCI_CHART="${VENDOR_HELM_RENDERED_OCI_CHART:-}"
MOVE_FILES_JSON="${VENDOR_HELM_RENDERED_MOVE_FILES:-}"
SED_REPLACE_JSON="${VENDOR_HELM_RENDERED_SED_REPLACE:-}"
YQ_TRANSFORM_JSON="${VENDOR_HELM_RENDERED_YQ_TRANSFORM:-}"
IMAGE_RETAGS_JSON="${VENDOR_HELM_RENDERED_IMAGE_RETAGS:-}"
USE_PROJECT_NAME_AS_FULLNAME_OVERRIDE="${VENDOR_HELM_RENDERED_USE_PROJECT_NAME_AS_FULLNAME_OVERRIDE:-true}"

# Version from src/config/VendorHelmRenderedVersion
VERSION_FILE="src/config/VendorHelmRenderedVersion"
if [[ ! -f "${VERSION_FILE}" ]]; then
  log_error "Version file not found: ${VERSION_FILE}"
  exit 1
fi
VERSION="$(tr -d '[:space:]' < "${VERSION_FILE}")"
log "Chart version: ${VERSION}"

# Project name for helm release name
PROJECT_NAME="${PROJECT_NAME:?PROJECT_NAME is required}"

# Validate chart source mode
HAS_REPO=false
HAS_OCI=false
if [[ -n "${REPO_URL}" && -n "${CHART_NAME}" ]]; then
  HAS_REPO=true
elif [[ -n "${REPO_URL}" && -z "${CHART_NAME}" ]]; then
  log_error "repoUrl is set but chartName is missing"
  exit 1
elif [[ -z "${REPO_URL}" && -n "${CHART_NAME}" ]]; then
  log_error "chartName is set but repoUrl is missing"
  exit 1
fi
if [[ -n "${OCI_CHART}" ]]; then
  HAS_OCI=true
fi
if [[ "${HAS_REPO}" == "true" && "${HAS_OCI}" == "true" ]]; then
  log_error "Both repoUrl+chartName and ociChart are set - these are mutually exclusive"
  exit 1
fi
if [[ "${HAS_REPO}" == "false" && "${HAS_OCI}" == "false" ]]; then
  log_error "Neither repoUrl+chartName nor ociChart is set - one must be configured"
  exit 1
fi

# Validate moveFiles
if [[ -z "${MOVE_FILES_JSON}" || "${MOVE_FILES_JSON}" == "null" || "${MOVE_FILES_JSON}" == "[]" ]]; then
  log_error "moveFiles must have at least one entry"
  exit 1
fi

# Validate helm is available
if ! command -v helm &>/dev/null; then
  log_error "helm is required but not found"
  exit 1
fi

# Setup directories
HELM_DIR="${OUTPUT_SUB_PATH}/helm-processing"
CHART_DIR="${HELM_DIR}/A-chart"
RENDERED_DIR="${HELM_DIR}/B-rendered"
SPLIT_DIR="${HELM_DIR}/C-split"
MOVED_DIR="${HELM_DIR}/D-moved-files"
SED_DIR="${HELM_DIR}/E-sed-replaced"
YQ_DIR="${HELM_DIR}/F-yq-transformed"
ANNOTATED_DIR="${HELM_DIR}/G-annotated"
VALIDATED_DIR="${HELM_DIR}/H-validated"

rm -rf "${HELM_DIR}"
mkdir -p "${CHART_DIR}" "${RENDERED_DIR}" "${SPLIT_DIR}" "${MOVED_DIR}" "${SED_DIR}" "${YQ_DIR}" "${ANNOTATED_DIR}" "${VALIDATED_DIR}"

# ==========================================================================
# Stage 1: Fetch chart
# ==========================================================================
log ""
log "Stage 1: Fetching chart..."

if [[ "${HAS_REPO}" == "true" ]]; then
  log "  Adding repo: ${REPO_URL} as ${REPO_NAME}"
  if ! repo_add_output=$(helm repo add "${REPO_NAME}" "${REPO_URL}" 2>&1); then
    log_error "helm repo add failed for '${REPO_NAME}':"
    log_error "  ${repo_add_output}"
    repo_add_advice="The name maps to a different URL from an earlier build. Remove the '${REPO_NAME}' repo using the following command then re-run:"
    while IFS= read -r advice_line; do
      log_error "${advice_line}"
    done < <(printf '%s\n' "${repo_add_advice}" | fold -s -w 80)
    log_error "  helm repo remove ${REPO_NAME}"
    exit 1
  fi
  log "  Fetching chart: ${REPO_NAME}/${CHART_NAME} --version ${VERSION}"
  helm fetch --version "${VERSION}" --destination "${CHART_DIR}" "${REPO_NAME}/${CHART_NAME}" --untar
  CHART_PATH="${CHART_DIR}/${CHART_NAME}"
else
  log "  Pulling OCI chart: ${OCI_CHART} --version ${VERSION}"
  helm pull "${OCI_CHART}" --version "${VERSION}" --destination "${CHART_DIR}" --untar
  # OCI charts extract to a directory named after the chart
  CHART_PATH="$(find "${CHART_DIR}" -mindepth 1 -maxdepth 1 -type d | head -1)"
  if [[ -z "${CHART_PATH}" ]]; then
    log_error "No chart directory found after helm pull"
    exit 1
  fi
fi
log "  Chart extracted to: ${CHART_PATH}"

# ==========================================================================
# Stage 2: Render
# ==========================================================================
log ""
log "Stage 2: Rendering chart..."

VALUES_FILE="src/vendor-helm-rendered/values-${VERSION}.yaml"
if [[ ! -f "${VALUES_FILE}" ]]; then
  mkdir -p "$(dirname "${VALUES_FILE}")"
  cp "${CHART_PATH}/values.yaml" "${VALUES_FILE}"
  log_error "Values file not found: ${VALUES_FILE}"
  log_error "The chart's default values.yaml has been copied to ${VALUES_FILE}"
  log_error "Add and commit this file, then customise it as needed and commit again."
  exit 1
fi
log "  Using values file: ${VALUES_FILE}"

if [[ "${USE_PROJECT_NAME_AS_FULLNAME_OVERRIDE}" == "true" ]]; then
  log "  fullnameOverride set to ${FULLNAME_PLACEHOLDER} (resolved to the project-name token in stage 7)"
  helm template "${PROJECT_NAME}" "${CHART_PATH}" \
    --namespace "${NAMESPACE_PLACEHOLDER}" \
    -f "${VALUES_FILE}" \
    --set "fullnameOverride=${FULLNAME_PLACEHOLDER}" \
    --output-dir "${RENDERED_DIR}"
else
  log "  fullnameOverride disabled by config"
  helm template "${PROJECT_NAME}" "${CHART_PATH}" \
    --namespace "${NAMESPACE_PLACEHOLDER}" \
    -f "${VALUES_FILE}" \
    --output-dir "${RENDERED_DIR}"
fi

log "  Rendered to ${RENDERED_DIR}"

# helm template only outputs templates/. Copy other chart directories (e.g. crds/)
# into the rendered output so they flow through to C-split and beyond.
RENDERED_CHART_NAME="$(find "${RENDERED_DIR}" -mindepth 1 -maxdepth 1 -type d | head -1)"
while IFS= read -r chart_subdir; do
  subdir_name="${chart_subdir##*/}"
  if [[ "${subdir_name}" == "templates" ]]; then
    continue
  fi
  if [[ -d "${RENDERED_CHART_NAME}/${subdir_name}" ]]; then
    log "  ${subdir_name}/ already in rendered output, skipping"
    continue
  fi
  log "  Copying non-template dir: ${subdir_name}/"
  cp -r "${chart_subdir}" "${RENDERED_CHART_NAME}/${subdir_name}"
done < <(find "${CHART_PATH}" -mindepth 1 -maxdepth 1 -type d)

# ==========================================================================
# Stage 3: Split multi-doc files
# ==========================================================================
log ""
log "Stage 3: Splitting multi-doc files..."

# Copy rendered output preserving subdirectory structure, stripping the chart root dir
RENDERED_CHART_DIR="$(find "${RENDERED_DIR}" -mindepth 1 -maxdepth 1 -type d | head -1)"
if [[ -z "${RENDERED_CHART_DIR}" ]]; then
  log_error "No chart directory found in ${RENDERED_DIR}"
  exit 1
fi
cp -r "${RENDERED_CHART_DIR}"/. "${SPLIT_DIR}/"

while IFS= read -r split_file; do
  rel_path="${split_file#"${SPLIT_DIR}"/}"
  base_name="${rel_path%.yaml}"

  doc_count=$(yq ea '[.] | length' "${split_file}")

  if [[ ${doc_count} -le 1 ]]; then
    log "  ${rel_path} (single doc)"
    continue
  fi

  # Multi-doc: split into base-0.yaml, base-1.yaml, etc then remove original
  yq eval-all --split-exp "\"${SPLIT_DIR}/${base_name}-\" + \$index + \".yaml\"" --no-doc -o yaml "${split_file}"
  rm -f "${split_file}"
  log "  ${rel_path} -> split into ${doc_count} files"
done < <(find "${SPLIT_DIR}" -name '*.yaml' -type f)

# Strip leading --- from all files (helm adds it, yq --no-doc only covers split files)
while IFS= read -r yaml_file; do
  sed -i.bak '1{/^---$/d;}' "${yaml_file}" && rm -f "${yaml_file}.bak"
done < <(find "${SPLIT_DIR}" -name '*.yaml' -type f)

# ==========================================================================
# Stage 3b: Normalise workload app labels and the selectors that target them
# ==========================================================================
#
# helm rendered with fullnameOverride=${PROJECT_NAME}, so metadata.name became
# the project's name while the chart's app.kubernetes.io/name label kept the
# UPSTREAM chart name. Kaptain requires a workload's pod-template app and
# app.kubernetes.io/name to equal its metadata.name: those are the labels that
# propagate to ReplicaSets and Pods, so they are what identifies pod ownership
# for deploy-time tooling.
#
# Pod labels cannot move alone. Every selector targeting them has to move in
# lockstep or the workload breaks - the API rejects a Deployment whose selector
# does not match its template, and a Service silently stops routing. So this
# rewrites the whole closure: the workload's own selector, its pod-level
# affinity and topology-spread selectors, and pod-targeting selectors on other
# resources.
#
# Placement: after the split (one resource per file) but before moveFiles, so
# association sees the complete chart, and before the sed/yq stages, so a
# project can still override anything decided here.
#
# Deliberate limits:
#   - Only keys the chart already uses are rewritten in selectors; we never
#     invent a selector key (that would change matching semantics).
#   - Job and CronJob selectors are controller-generated and never written.
#   - Association is by label match, not inference. Exactly one workload gets
#     a rewrite; none or several are left alone and warned about, because
#     narrowing a deliberately broad selector would silently change it.
if [[ "${USE_PROJECT_NAME_AS_FULLNAME_OVERRIDE}" == "true" ]]; then
  log ""
  log "Stage 3b: Normalising workload app labels and dependent selectors..."

  NORM_INDEX_DIR="${HELM_DIR}/normalisation-index"
  rm -rf "${NORM_INDEX_DIR}"
  mkdir -p "${NORM_INDEX_DIR}"

  # Pass 1: index every workload with its ORIGINAL pod-template labels - what
  # other resources' selectors were written against, so matching must use them.
  NORM_WORKLOADS=0
  while IFS= read -r manifest; do
    norm_kind=$(yq eval '.kind // ""' "${manifest}")
    case "${norm_kind}" in
      Deployment|StatefulSet|DaemonSet|ReplicaSet) norm_tmpl=".spec.template" ;;
      # Job and CronJob are deliberately excluded: their pods are owned
      # directly (no selector indirection), so an app label is not needed to
      # establish ownership, and their selectors are controller-generated and
      # must never be written.
      *) continue ;;
    esac
    norm_name=$(yq eval '.metadata.name // ""' "${manifest}")
    if [[ -z "${norm_name}" || "${norm_name}" == "null" ]]; then
      continue
    fi
    printf '%s\n' "${norm_name}" > "${NORM_INDEX_DIR}/${NORM_WORKLOADS}.name"
    printf '%s\n' "${manifest}" > "${NORM_INDEX_DIR}/${NORM_WORKLOADS}.file"
    printf '%s\n' "${norm_tmpl}" > "${NORM_INDEX_DIR}/${NORM_WORKLOADS}.tmpl"
    printf '%s\n' "${norm_kind}" > "${NORM_INDEX_DIR}/${NORM_WORKLOADS}.kind"
    yq eval "${norm_tmpl}.metadata.labels // {} | to_entries | .[] | .key + \"=\" + (.value | tostring)" \
      "${manifest}" > "${NORM_INDEX_DIR}/${NORM_WORKLOADS}.labels"
    NORM_WORKLOADS=$((NORM_WORKLOADS + 1))
  done < <(find "${SPLIT_DIR}" -name '*.yaml' -type f)

  log "  Indexed ${NORM_WORKLOADS} workload(s)"

  # Pass 2: the workloads themselves.
  norm_i=0
  while [[ ${norm_i} -lt ${NORM_WORKLOADS} ]]; do
    norm_name=$(cat "${NORM_INDEX_DIR}/${norm_i}.name")
    norm_file=$(cat "${NORM_INDEX_DIR}/${norm_i}.file")
    norm_tmpl=$(cat "${NORM_INDEX_DIR}/${norm_i}.tmpl")
    norm_kind=$(cat "${NORM_INDEX_DIR}/${norm_i}.kind")
    export NORM_NAME="${norm_name}"

    # Pod template: both keys set outright, added when the chart omits them.
    yq -i "${norm_tmpl}.metadata.labels.app = strenv(NORM_NAME) |
           ${norm_tmpl}.metadata.labels.\"app.kubernetes.io/name\" = strenv(NORM_NAME)" "${norm_file}"

    # The workload's own selector: only keys the chart already uses.
    yq -i "(select(.spec.selector.matchLabels.app != null) |
            .spec.selector.matchLabels.app) = strenv(NORM_NAME)" "${norm_file}"
    yq -i "(select(.spec.selector.matchLabels.\"app.kubernetes.io/name\" != null) |
            .spec.selector.matchLabels.\"app.kubernetes.io/name\") = strenv(NORM_NAME)" "${norm_file}"

    # Pod-level selectors inside the template. The parent guard matters: an
    # unguarded [] traversal CREATES the absent path.
    for norm_sel in \
      "${norm_tmpl}.spec.affinity.podAffinity.requiredDuringSchedulingIgnoredDuringExecution" \
      "${norm_tmpl}.spec.affinity.podAntiAffinity.requiredDuringSchedulingIgnoredDuringExecution" \
      "${norm_tmpl}.spec.topologySpreadConstraints" ; do
      yq -i "(select(${norm_sel} != null) | ${norm_sel}[].labelSelector.matchLabels |
              select(has(\"app\")) | .app) = strenv(NORM_NAME)" "${norm_file}"
      yq -i "(select(${norm_sel} != null) | ${norm_sel}[].labelSelector.matchLabels |
              select(has(\"app.kubernetes.io/name\")) | .[\"app.kubernetes.io/name\"]) = strenv(NORM_NAME)" "${norm_file}"
    done
    for norm_sel in \
      "${norm_tmpl}.spec.affinity.podAffinity.preferredDuringSchedulingIgnoredDuringExecution" \
      "${norm_tmpl}.spec.affinity.podAntiAffinity.preferredDuringSchedulingIgnoredDuringExecution" ; do
      yq -i "(select(${norm_sel} != null) | ${norm_sel}[].podAffinityTerm.labelSelector.matchLabels |
              select(has(\"app\")) | .app) = strenv(NORM_NAME)" "${norm_file}"
      yq -i "(select(${norm_sel} != null) | ${norm_sel}[].podAffinityTerm.labelSelector.matchLabels |
              select(has(\"app.kubernetes.io/name\")) | .[\"app.kubernetes.io/name\"]) = strenv(NORM_NAME)" "${norm_file}"
    done

    log "  ${norm_file#"${SPLIT_DIR}"/}: ${norm_kind} ${norm_name} -> pod labels and selectors set to '${norm_name}'"
    norm_i=$((norm_i + 1))
  done

  # Pass 3: pod-targeting selectors on other resources, associated by matching
  # the selector against the original pod labels captured in pass 1.
  while IFS= read -r manifest; do
    norm_kind=$(yq eval '.kind // ""' "${manifest}")
    case "${norm_kind}" in
      # Service.spec.selector is a plain map[string]string in core/v1: equality
      # only, so a set of workloads cannot be expressed. The rest are
      # metav1.LabelSelector and support matchExpressions.
      Service) norm_path=".spec.selector"; norm_base=""; norm_supports_expr="false" ;;
      PodDisruptionBudget|ServiceMonitor|PodMonitor)
        norm_path=".spec.selector.matchLabels"; norm_base=".spec.selector"; norm_supports_expr="true" ;;
      NetworkPolicy)
        norm_path=".spec.podSelector.matchLabels"; norm_base=".spec.podSelector"; norm_supports_expr="true" ;;
      *) continue ;;
    esac

    # Nothing to do unless it uses a key we would rewrite. Both has() calls must
    # sit inside the same pipeline stage - yq binds '|' tighter than 'or', so an
    # unparenthesised second operand would be evaluated against the document root.
    if [[ "$(yq eval "(${norm_path} // {}) | (has(\"app\") or has(\"app.kubernetes.io/name\"))" "${manifest}")" != "true" ]]; then
      continue
    fi

    norm_rel="${manifest#"${SPLIT_DIR}"/}"
    norm_res_name=$(yq eval '.metadata.name // ""' "${manifest}")
    yq eval "${norm_path} | to_entries | .[] | .key + \"=\" + (.value | tostring)" \
      "${manifest}" > "${NORM_INDEX_DIR}/selector-pairs"

    norm_matches=0
    norm_match_name=""
    norm_match_list=""
    norm_j=0
    while [[ ${norm_j} -lt ${NORM_WORKLOADS} ]]; do
      norm_satisfied="true"
      while IFS= read -r norm_pair; do
        [[ -z "${norm_pair}" ]] && continue
        if ! grep -qxF "${norm_pair}" "${NORM_INDEX_DIR}/${norm_j}.labels"; then
          norm_satisfied="false"
          break
        fi
      done < "${NORM_INDEX_DIR}/selector-pairs"
      if [[ "${norm_satisfied}" == "true" ]]; then
        norm_matches=$((norm_matches + 1))
        norm_match_name=$(cat "${NORM_INDEX_DIR}/${norm_j}.name")
        if [[ -z "${norm_match_list}" ]]; then
          norm_match_list="${norm_match_name}"
        else
          norm_match_list="${norm_match_list},${norm_match_name}"
        fi
      fi
      norm_j=$((norm_j + 1))
    done

    # A selector whose app value already names a workload is aimed at that
    # workload by name: once its pod labels are normalised the selector matches
    # it exactly, so there is nothing to warn about even if the original labels
    # matched several workloads (or none).
    norm_sel_app=$(yq eval "${norm_path}.app // \"\"" "${manifest}")
    norm_sel_name=$(yq eval "${norm_path}.\"app.kubernetes.io/name\" // \"\"" "${manifest}")
    norm_by_name=""
    norm_j=0
    while [[ ${norm_j} -lt ${NORM_WORKLOADS} ]]; do
      norm_candidate=$(cat "${NORM_INDEX_DIR}/${norm_j}.name")
      if [[ -n "${norm_candidate}" ]] \
         && { [[ "${norm_candidate}" == "${norm_sel_app}" ]] || [[ "${norm_candidate}" == "${norm_sel_name}" ]]; }; then
        norm_by_name="${norm_candidate}"
        break
      fi
      norm_j=$((norm_j + 1))
    done

    if [[ ${norm_matches} -eq 1 ]]; then
      export NORM_NAME="${norm_match_name}"
      yq -i "(select(${norm_path}.app != null) | ${norm_path}.app) = strenv(NORM_NAME)" "${manifest}"
      yq -i "(select(${norm_path}.\"app.kubernetes.io/name\" != null) |
              ${norm_path}.\"app.kubernetes.io/name\") = strenv(NORM_NAME)" "${manifest}"
      log "  ${norm_rel}: ${norm_kind} ${norm_res_name} selector -> '${norm_match_name}'"
    elif [[ ${norm_matches} -gt 1 && "${norm_supports_expr}" == "true" ]]; then
      # Deliberately spans several workloads. metav1.LabelSelector can express
      # that: move the app key out of matchLabels into an In expression over the
      # matched workloads. matchLabels and matchExpressions are ANDed, so the
      # other keys stay put and the selected pod set is unchanged.
      export NORM_VALUES="${norm_match_list}"
      for norm_key in "app" "app.kubernetes.io/name"; do
        export NORM_KEY="${norm_key}"
        if [[ "$(yq eval "(${norm_path} // {}) | has(\"${norm_key}\")" "${manifest}")" != "true" ]]; then
          continue
        fi
        yq -i "del(${norm_path}.\"${norm_key}\") |
               ${norm_base}.matchExpressions += [{\"key\": strenv(NORM_KEY),
                                                  \"operator\": \"In\",
                                                  \"values\": (strenv(NORM_VALUES) | split(\",\"))}]" "${manifest}"
      done
      # Drop matchLabels if the app key was all it held.
      yq -i "del(select(${norm_path} != null and (${norm_path} | length == 0)) | ${norm_path})" "${manifest}"
      log "  ${norm_rel}: ${norm_kind} ${norm_res_name} spans ${norm_matches} workloads -> matchExpressions In [${norm_match_list}]"
    elif [[ -n "${norm_by_name}" ]]; then
      # Aligns both keys on that workload; a no-op for whichever key already
      # held the name, and it keeps the two consistent when only one did.
      export NORM_NAME="${norm_by_name}"
      yq -i "(select(${norm_path}.app != null) | ${norm_path}.app) = strenv(NORM_NAME)" "${manifest}"
      yq -i "(select(${norm_path}.\"app.kubernetes.io/name\" != null) |
              ${norm_path}.\"app.kubernetes.io/name\") = strenv(NORM_NAME)" "${manifest}"
      log "  ${norm_rel}: ${norm_kind} ${norm_res_name} selector already names workload '${norm_by_name}' (${norm_matches} label match(es)) - aligned"
    elif [[ "${norm_supports_expr}" == "false" ]]; then
      log_warning "${norm_rel}: ${norm_kind} ${norm_res_name} selector matches ${norm_matches} workloads and names none of them. A Service selector is a plain equality map and cannot express a set, so this cannot be fixed automatically - repoint it at a still-shared label such as app.kubernetes.io/instance using yqTransform. The post-check will fail the build if it still selects nothing."
    else
      log_warning "${norm_rel}: ${norm_kind} ${norm_res_name} selector matches ${norm_matches} workloads and names none of them, left unchanged. Pod app labels are now per-workload, so it will no longer select what it did - narrow it with yqTransform if that matters."
    fi

    # matchExpressions cannot be rewritten safely (In/NotIn value sets), so flag.
    if [[ "$(yq eval '(.spec.selector.matchExpressions // .spec.podSelector.matchExpressions // []) | map(select(.key == "app" or .key == "app.kubernetes.io/name")) | length > 0' "${manifest}")" == "true" ]]; then
      log_warning "${norm_rel}: ${norm_kind} ${norm_res_name} uses matchExpressions on an app label; not rewritten, handle it with yqTransform"
    fi
  done < <(find "${SPLIT_DIR}" -name '*.yaml' -type f)
else
  log ""
  log "Stage 3b: fullnameOverride disabled - leaving the chart's own app labels and selectors alone"
fi

# ==========================================================================
# Stage 4: Move files (keep only moveFiles, discard the rest)
# ==========================================================================
log ""
log "Stage 4: Moving files..."

MOVE_COUNT=$(echo "${MOVE_FILES_JSON}" | jq length)
MOVE_ERRORS=0
for ((i = 0; i < MOVE_COUNT; i++)); do
  SOURCE=$(echo "${MOVE_FILES_JSON}" | jq -r ".[${i}].source")
  DEST=$(echo "${MOVE_FILES_JSON}" | jq -r ".[${i}].destination")

  if [[ ! -f "${SPLIT_DIR}/${SOURCE}" ]]; then
    log_error "  moveFiles source not found in C-split/: ${SOURCE}"
    MOVE_ERRORS=$((MOVE_ERRORS + 1))
    continue
  fi

  mkdir -p "$(dirname "${MOVED_DIR}/${DEST}")"
  cp "${SPLIT_DIR}/${SOURCE}" "${MOVED_DIR}/${DEST}"
  log "  ${SOURCE} -> ${DEST}"
done

if [[ ${MOVE_ERRORS} -gt 0 ]]; then
  log_error "${MOVE_ERRORS} moveFiles source(s) not found"
  log "Available files in C-split/:"
  find "${SPLIT_DIR}" -name '*.yaml' -type f | sed "s|^${SPLIT_DIR}/||" | LC_ALL=C sort | sed 's/^/  /'
  exit 1
fi

# ==========================================================================
# Stage 5: Sed Replace
# ==========================================================================
log ""
log "Stage 5: Applying sed replacements..."

cp -r "${MOVED_DIR}"/. "${SED_DIR}/"

if [[ -n "${SED_REPLACE_JSON}" && "${SED_REPLACE_JSON}" != "null" && "${SED_REPLACE_JSON}" != "{}" ]]; then
  # Global sed patterns
  GLOBAL_SED_COUNT=$(echo "${SED_REPLACE_JSON}" | jq '.global // [] | length')
  for ((i = 0; i < GLOBAL_SED_COUNT; i++)); do
    PATTERN=$(echo "${SED_REPLACE_JSON}" | jq -r ".global[${i}]")
    log "  global: ${PATTERN}"
    while IFS= read -r manifest; do
      sed -i.bak "${PATTERN}" "${manifest}" && rm -f "${manifest}.bak"
    done < <(find "${SED_DIR}" -name '*.yaml' -type f)
  done

  # Per-file sed patterns
  PER_FILE_SED_COUNT=$(echo "${SED_REPLACE_JSON}" | jq '.perFile // [] | length')
  for ((i = 0; i < PER_FILE_SED_COUNT; i++)); do
    TARGET_FILE=$(echo "${SED_REPLACE_JSON}" | jq -r ".perFile[${i}].file")
    PATTERN_COUNT=$(echo "${SED_REPLACE_JSON}" | jq ".perFile[${i}].patterns | length")

    if [[ ! -f "${SED_DIR}/${TARGET_FILE}" ]]; then
      log "  WARNING: sed perFile target '${TARGET_FILE}' not found in E-sed-replaced/"
      continue
    fi

    for ((j = 0; j < PATTERN_COUNT; j++)); do
      PATTERN=$(echo "${SED_REPLACE_JSON}" | jq -r ".perFile[${i}].patterns[${j}]")
      log "  ${TARGET_FILE}: ${PATTERN}"
      sed -i.bak "${PATTERN}" "${SED_DIR}/${TARGET_FILE}" && rm -f "${SED_DIR}/${TARGET_FILE}.bak"
    done
  done
else
  log "  No sed replacements configured"
fi

# ==========================================================================
# Stage 6: yq Transform (inline yq, then file-based yq)
# ==========================================================================
log ""
log "Stage 6: Applying yq transforms..."

cp -r "${SED_DIR}"/. "${YQ_DIR}/"

# Inline yq transforms (from KaptainPM.yaml yqTransform)
if [[ -n "${YQ_TRANSFORM_JSON}" && "${YQ_TRANSFORM_JSON}" != "null" && "${YQ_TRANSFORM_JSON}" != "{}" ]]; then
  # Global inline yq expressions
  GLOBAL_YQ_COUNT=$(echo "${YQ_TRANSFORM_JSON}" | jq '.global // [] | length')
  for ((i = 0; i < GLOBAL_YQ_COUNT; i++)); do
    EXPRESSION=$(echo "${YQ_TRANSFORM_JSON}" | jq -r ".global[${i}]")
    log "  inline global: ${EXPRESSION}"
    while IFS= read -r manifest; do
      yq eval -i "${EXPRESSION}" "${manifest}"
    done < <(find "${YQ_DIR}" -name '*.yaml' -type f)
  done

  # Per-file inline yq expressions
  PER_FILE_YQ_COUNT=$(echo "${YQ_TRANSFORM_JSON}" | jq '.perFile // [] | length')
  for ((i = 0; i < PER_FILE_YQ_COUNT; i++)); do
    TARGET_FILE=$(echo "${YQ_TRANSFORM_JSON}" | jq -r ".perFile[${i}].file")
    EXPR_COUNT=$(echo "${YQ_TRANSFORM_JSON}" | jq ".perFile[${i}].expressions | length")

    if [[ ! -f "${YQ_DIR}/${TARGET_FILE}" ]]; then
      log "  WARNING: yq perFile target '${TARGET_FILE}' not found in F-yq-transformed/"
      continue
    fi

    for ((j = 0; j < EXPR_COUNT; j++)); do
      EXPRESSION=$(echo "${YQ_TRANSFORM_JSON}" | jq -r ".perFile[${i}].expressions[${j}]")
      log "  inline ${TARGET_FILE}: ${EXPRESSION}"
      yq eval -i "${EXPRESSION}" "${YQ_DIR}/${TARGET_FILE}"
    done
  done
fi

# File-based yq transforms (from src/vendor-helm-rendered/)
TRANSFORMS_GLOBAL="src/vendor-helm-rendered/transforms-global"
TRANSFORMS_PER_FILE="src/vendor-helm-rendered/transforms"

if [[ -d "${TRANSFORMS_GLOBAL}" ]]; then
  for transform in $(find "${TRANSFORMS_GLOBAL}" -name '*.yq' -type f | LC_ALL=C sort); do
    transform_name="$(basename "${transform}")"
    log "  file global: ${transform_name}"
    while IFS= read -r manifest; do
      yq eval -i "$(cat "${transform}")" "${manifest}"
    done < <(find "${YQ_DIR}" -name '*.yaml' -type f)
  done
fi

if [[ -d "${TRANSFORMS_PER_FILE}" ]]; then
  for target_dir in "${TRANSFORMS_PER_FILE}"/*/; do
    [[ -d "${target_dir}" ]] || continue
    target_name="$(basename "${target_dir}")"
    target_file="${YQ_DIR}/${target_name}.yaml"

    if [[ ! -f "${target_file}" ]]; then
      log "  WARNING: Transform dir '${target_name}' has no matching file in F-yq-transformed/"
      continue
    fi

    for transform in $(find "${target_dir}" -name '*.yq' -type f | LC_ALL=C sort); do
      transform_name="$(basename "${transform}")"
      log "  file ${target_name}: ${transform_name}"
      yq eval -i "$(cat "${transform}")" "${target_file}"
    done
  done
fi

# ==========================================================================
# Stage 7: Annotate
# ==========================================================================
#
# Kaptain metadata sites: this is one of three places that emit `kaptain.org/*`
# labels and annotations. When changing the key set or types here, also review
# the others. See AnnotationLabelConsistency.md for the full set.
#   1. src/scripts/lib/kubernetes-metadata.bash::generate_metadata
#   2. src/scripts/main/layer-package-prepare
#   3. src/scripts/main/vendor-helm-render-and-process (this block)
#
# Vendor emits the generator superset minus kaptain.org/image-uri (vendor has
# no image-uri at this point in the pipeline) plus kaptain.org/environment as
# a label. Single-write throughout (no label/annotation duplication).
#
# app / app.kubernetes.io/name identify the APPLICATION (the project), not the
# individual resource. Using .metadata.name put the resource's own name there,
# which is wrong per the Kubernetes recommended-labels spec and actively broken
# for cluster-scoped resources: charts commonly template .Release.Namespace
# into a ClusterRole name to avoid cross-namespace collisions, so the sentinel
# sweep below would rewrite the namespace into the label too. Charts that ship
# several workloads already distinguish their parts with
# app.kubernetes.io/component, which is preserved here untouched.
#
# Only TOP-LEVEL .metadata.labels are rewritten - the chart's spec.selector and
# spec.template.metadata.labels are never touched, so these labels are purely
# descriptive and no pod/ReplicaSet selection depends on them.
log ""
log "Stage 7: Injecting kaptain labels and annotations..."

cp -r "${YQ_DIR}"/. "${ANNOTATED_DIR}/"

# Resolve build provenance once for the whole loop.
if [[ -n "${REPOSITORY_OWNER:-}" && -n "${REPOSITORY_NAME:-}" ]]; then
  export SOURCE_REPO="${REPOSITORY_OWNER}/${REPOSITORY_NAME}"
fi

# Resolve token literals once, respecting the project's configured delimiter
# and name style (defaults: shell + PascalCase, e.g. ${ProjectName}).
export PROJECT_NAME_TOKEN VERSION_TOKEN ENVIRONMENT_TOKEN PRODUCT_NAME_TOKEN
PROJECT_NAME_TOKEN=$(format_canonical_token "${TOKEN_DELIMITER_STYLE}" "${TOKEN_NAME_STYLE}" "PROJECT_NAME")
VERSION_TOKEN=$(format_canonical_token "${TOKEN_DELIMITER_STYLE}" "${TOKEN_NAME_STYLE}" "VERSION")
ENVIRONMENT_TOKEN=$(format_canonical_token "${TOKEN_DELIMITER_STYLE}" "${TOKEN_NAME_STYLE}" "ENVIRONMENT")
PRODUCT_NAME_TOKEN=$(format_canonical_token "${TOKEN_DELIMITER_STYLE}" "${TOKEN_NAME_STYLE}" "PRODUCT_NAME")

# Read the upstream chart name+version from the rendered Chart.yaml so the
# kaptain.org/helm-upstream-chart annotation matches what helm itself would
# stamp into the helm.sh/chart label, but works for both repo and OCI flows
# (where VENDOR_HELM_RENDERED_CHART_NAME is unset).
export HELM_UPSTREAM_CHART
HELM_UPSTREAM_CHART=$(yq eval '"\(.name)-\(.version)"' "${CHART_PATH}/Chart.yaml")

# Build metadata yq pipeline. Required keys go in the static heredoc; optional
# keys (those depending on env vars that may not be set in every run context)
# are appended only when their env var has a value. helm.sh keys are enumerated
# explicitly (no regex) - the set helm itself emits is small and stable: chart
# label, hook annotations, resource-policy.
metadata_yq='
  .metadata.labels.app = strenv(PROJECT_NAME_TOKEN) |
  .metadata.labels."app.kubernetes.io/name" = strenv(PROJECT_NAME_TOKEN) |
  .metadata.labels."app.kubernetes.io/version" = strenv(VERSION_TOKEN) |
  .metadata.labels."app.kubernetes.io/version" style = "double" |
  .metadata.labels."app.kubernetes.io/managed-by" = "Kaptain" |
  .metadata.labels."app.kubernetes.io/part-of" = strenv(PRODUCT_NAME_TOKEN) |
  .metadata.labels."kaptain.org/environment" = strenv(ENVIRONMENT_TOKEN) |
  .metadata.labels."kaptain.org/product" = strenv(PRODUCT_NAME_TOKEN) |
  .metadata.labels."kaptain.org/project-name" = strenv(PROJECT_NAME_TOKEN) |
  .metadata.labels."kaptain.org/version" = strenv(VERSION_TOKEN) |
  .metadata.labels."kaptain.org/version" style = "double" |
  .metadata.annotations."kaptain.org/helm-upstream-chart" = strenv(HELM_UPSTREAM_CHART) |
  .metadata.annotations."kaptain.org/generated-by" = "Generated by Kaptain vendor-helm-render-and-process"
'
if [[ -n "${REPOSITORY_OWNER:-}" ]]; then
  metadata_yq="${metadata_yq} | .metadata.labels.\"kaptain.org/owner\" = strenv(REPOSITORY_OWNER)"
fi
# kaptain.org/built-by is stamped later by vendor-helm-inject-build-details so the
# vendor render output stays identical between local and CI runs (and so it
# doesn't trip vendor-helm-render-validate's diff check against src/kubernetes/).
if [[ -n "${SOURCE_REPO:-}" ]]; then
  metadata_yq="${metadata_yq} | .metadata.annotations.\"kaptain.org/source-repository\" = strenv(SOURCE_REPO)"
fi
metadata_yq="${metadata_yq} |
  del(.metadata.labels.\"helm.sh/chart\") |
  del(.metadata.annotations.\"helm.sh/hook\") |
  del(.metadata.annotations.\"helm.sh/hook-weight\") |
  del(.metadata.annotations.\"helm.sh/hook-delete-policy\") |
  del(.metadata.annotations.\"helm.sh/resource-policy\")"

while IFS= read -r manifest; do
  rel_path="${manifest#"${ANNOTATED_DIR}"/}"

  # Determine if namespaced or cluster-scoped. Allow-list of known namespaced
  # built-in kinds. Unknown kinds (CRDs we don't have a mapping for) default to
  # cluster-scoped here so we don't stamp a namespace onto something that
  # rejects it. Charts that ship namespaced CRDs are expected to template
  # `.Release.Namespace` themselves, which the sentinel sweep below resolves.
  KIND="$(yq eval '.kind' "${manifest}")"
  IS_NAMESPACED=false
  case "${KIND}" in
    Pod|Deployment|StatefulSet|DaemonSet|ReplicaSet|ReplicationController|\
    Job|CronJob|\
    Service|Endpoints|EndpointSlice|Ingress|NetworkPolicy|\
    ConfigMap|Secret|ServiceAccount|\
    PersistentVolumeClaim|\
    HorizontalPodAutoscaler|PodDisruptionBudget|LimitRange|ResourceQuota|\
    Role|RoleBinding|\
    Lease|Event|ControllerRevision)
      IS_NAMESPACED=true
      ;;
  esac

  # Add labels and annotations
  yq eval -i "${metadata_yq}" "${manifest}"

  # Set namespace for namespaced resources
  if [[ "${IS_NAMESPACED}" == "true" ]]; then
    yq eval -i '.metadata.namespace = strenv(ENVIRONMENT_TOKEN)' "${manifest}"
  fi

  log "  ${rel_path} ($(if [[ "${IS_NAMESPACED}" == "true" ]]; then echo "namespaced"; else echo "cluster-scoped"; fi))"
done < <(find "${ANNOTATED_DIR}" -name '*.yaml' -type f)

# Sentinel sweep: replace the namespace placeholder helm stamped from
# .Release.Namespace into every other field (subjects[].namespace,
# secretKeyRef.namespace, configMapKeyRef.namespace, webhook
# clientConfig.service.namespace, etc.) with the project-styled environment
# token. .metadata.namespace was already overwritten by the yq above; this
# catches everything else.
log "  Resolving namespace sentinel to ${ENVIRONMENT_TOKEN}"
if [[ "${USE_PROJECT_NAME_AS_FULLNAME_OVERRIDE}" == "true" ]]; then
  log "  Resolving fullname sentinel to ${PROJECT_NAME_TOKEN}"
fi
while IFS= read -r manifest; do
  sed -i.bak -e "s|${NAMESPACE_PLACEHOLDER}|${ENVIRONMENT_TOKEN}|g" \
             -e "s|${FULLNAME_PLACEHOLDER}|${PROJECT_NAME_TOKEN}|g" "${manifest}" \
    && rm -f "${manifest}.bak"
done < <(find "${ANNOTATED_DIR}" -name '*.yaml' -type f)

# Nothing may survive the sweep. A chart that truncates a sentinel (name helpers
# routinely end `| trunc 63`) or transforms it would leave a fragment the
# substitutions above cannot match, and that fragment would ship as part of a
# real resource name. Match on prefixes so partial remains are caught too - they
# cannot collide with the kaptain.org/* labels, which use a dot not a hyphen.
SENTINEL_REMNANTS=$(grep -rl "kaptain-namespace\|kaptain-fullname" "${ANNOTATED_DIR}" 2>/dev/null || true)
if [[ -n "${SENTINEL_REMNANTS}" ]]; then
  log_error "Sentinel fragments survived the sweep:"
  while IFS= read -r remnant; do
    [[ -z "${remnant}" ]] && continue
    log_error "  ${remnant#"${ANNOTATED_DIR}"/}: $(grep -o "kaptain-[a-z-]*" "${remnant}" | sort -u | tr '\n' ' ')"
  done <<< "${SENTINEL_REMNANTS}"
  log_error "A chart has truncated or rewritten a placeholder, so it cannot be resolved"
  log_error "to a token. Shorten the sentinel, or handle that resource with yqTransform."
  exit 1
fi

# ==========================================================================
# Stage 8: Validate
# ==========================================================================
log ""
log "Stage 8: Validating YAML..."

VALIDATE_ERRORS=0
while IFS= read -r manifest; do
  rel_path="${manifest#"${ANNOTATED_DIR}"/}"

  if yq eval '.' "${manifest}" > /dev/null 2>&1; then
    log "  ✓ ${rel_path}"
  else
    log_error "  ✗ ${rel_path} - invalid YAML"
    yq eval '.' "${manifest}" 2>&1 | head -3
    VALIDATE_ERRORS=$((VALIDATE_ERRORS + 1))
  fi
done < <(find "${ANNOTATED_DIR}" -name '*.yaml' -type f)

if [[ ${VALIDATE_ERRORS} -gt 0 ]]; then
  log_error "${VALIDATE_ERRORS} file(s) failed YAML validation"
  exit 1
fi

# Workload label closure. Runs regardless of who established it - stage 3b, the
# chart itself, or the project's own sed/yq transforms - because these two
# invariants are what make pod ownership identifiable and keep the workload
# acceptable to the API server:
#   1. pod-template app and app.kubernetes.io/name equal the workload's
#      metadata.name (these are the labels that reach ReplicaSets and Pods)
#   2. the workload's selector is satisfied by its own pod-template labels
# Job and CronJob are excluded, as in stage 3b.
log ""
log "Stage 8b: Validating workload label closure..."

CLOSURE_ERRORS=0
CLOSURE_LABELS_FILE="${HELM_DIR}/closure-pod-labels"
while IFS= read -r manifest; do
  closure_kind=$(yq eval '.kind // ""' "${manifest}")
  case "${closure_kind}" in
    Deployment|StatefulSet|DaemonSet|ReplicaSet) closure_tmpl=".spec.template" ;;
    *) continue ;;
  esac

  closure_rel="${manifest#"${ANNOTATED_DIR}"/}"
  closure_name=$(yq eval '.metadata.name // ""' "${manifest}")
  closure_file_errors=0

  # One app-style label is enough to identify pod ownership, so require either
  # the legacy `app` or the modern `app.kubernetes.io/name` rather than both -
  # charts that carry only one (and projects that opt out of fullnameOverride
  # and so are never normalised) are perfectly serviceable. Where both exist
  # they must agree, and the agreed value must be metadata.name.
  closure_app=$(yq eval "${closure_tmpl}.metadata.labels.app // \"\"" "${manifest}")
  closure_app_kube=$(yq eval "${closure_tmpl}.metadata.labels.\"app.kubernetes.io/name\" // \"\"" "${manifest}")

  if [[ -z "${closure_app}" && -z "${closure_app_kube}" ]]; then
    log_error "  ✗ ${closure_rel}: ${closure_kind} ${closure_name} pod template carries neither 'app' nor 'app.kubernetes.io/name'; one is required to identify pod ownership"
    closure_file_errors=$((closure_file_errors + 1))
  elif [[ -n "${closure_app}" && -n "${closure_app_kube}" && "${closure_app}" != "${closure_app_kube}" ]]; then
    log_error "  ✗ ${closure_rel}: ${closure_kind} ${closure_name} pod template labels disagree - 'app' is '${closure_app}' but 'app.kubernetes.io/name' is '${closure_app_kube}'"
    closure_file_errors=$((closure_file_errors + 1))
  else
    closure_app_value="${closure_app:-${closure_app_kube}}"
    if [[ "${closure_app_value}" != "${closure_name}" ]]; then
      log_error "  ✗ ${closure_rel}: ${closure_kind} pod template app label is '${closure_app_value}', must equal metadata.name '${closure_name}'"
      closure_file_errors=$((closure_file_errors + 1))
    fi
  fi

  # Extract the pod labels to a file and grep the FILE, never a pipe: `yq |
  # grep -q` exits early, SIGPIPEs yq, and pipefail then turns a successful
  # match into a pipeline failure (intermittently, depending on buffering).
  if [[ "$(yq eval '(.spec.selector.matchLabels // {}) | length > 0' "${manifest}")" == "true" ]]; then
    yq eval "(${closure_tmpl}.metadata.labels // {}) | to_entries | .[] | .key + \"=\" + (.value | tostring)" \
      "${manifest}" > "${CLOSURE_LABELS_FILE}"
    while IFS= read -r closure_pair; do
      [[ -z "${closure_pair}" ]] && continue
      if ! grep -qxF "${closure_pair}" "${CLOSURE_LABELS_FILE}"; then
        log_error "  ✗ ${closure_rel}: ${closure_kind} ${closure_name} selector requires '${closure_pair}' which its pod template does not carry"
        closure_file_errors=$((closure_file_errors + 1))
      fi
    done < <(yq eval '.spec.selector.matchLabels | to_entries | .[] | .key + "=" + (.value | tostring)' "${manifest}")
  fi

  if [[ ${closure_file_errors} -eq 0 ]]; then
    log "  ✓ ${closure_rel}"
  else
    CLOSURE_ERRORS=$((CLOSURE_ERRORS + closure_file_errors))
  fi
done < <(find "${ANNOTATED_DIR}" -name '*.yaml' -type f)

# Service reachability. A Service selector is a plain equality map, so when it
# used a shared app label to span several workloads we cannot rewrite it (unlike
# the LabelSelector kinds, which get an In expression). The project is expected
# to repoint it with yqTransform; this gate makes sure that actually happened
# rather than shipping a Service that silently selects nothing. Only selectors
# that reference an app key are checked - that is the blast radius of the
# relabelling.
CLOSURE_FINAL_INDEX="${HELM_DIR}/closure-final-index"
rm -rf "${CLOSURE_FINAL_INDEX}"
mkdir -p "${CLOSURE_FINAL_INDEX}"
CLOSURE_WORKLOADS=0
while IFS= read -r manifest; do
  case "$(yq eval '.kind // ""' "${manifest}")" in
    Deployment|StatefulSet|DaemonSet|ReplicaSet) closure_tmpl=".spec.template" ;;
    Job) closure_tmpl=".spec.template" ;;
    CronJob) closure_tmpl=".spec.jobTemplate.spec.template" ;;
    *) continue ;;
  esac
  yq eval "(${closure_tmpl}.metadata.labels // {}) | to_entries | .[] | .key + \"=\" + (.value | tostring)" \
    "${manifest}" > "${CLOSURE_FINAL_INDEX}/${CLOSURE_WORKLOADS}.labels"
  CLOSURE_WORKLOADS=$((CLOSURE_WORKLOADS + 1))
done < <(find "${ANNOTATED_DIR}" -name '*.yaml' -type f)

while IFS= read -r manifest; do
  # Nothing to check against when the shipped set has no workloads at all (a
  # moveFiles selection may legitimately ship satellite resources on their own,
  # in which case the Service targets pods this chart does not carry).
  [[ ${CLOSURE_WORKLOADS} -gt 0 ]] || break
  [[ "$(yq eval '.kind // ""' "${manifest}")" == "Service" ]] || continue
  if [[ "$(yq eval '(.spec.selector // {}) | (has("app") or has("app.kubernetes.io/name"))' "${manifest}")" != "true" ]]; then
    continue
  fi

  closure_rel="${manifest#"${ANNOTATED_DIR}"/}"
  closure_name=$(yq eval '.metadata.name // ""' "${manifest}")
  yq eval '.spec.selector | to_entries | .[] | .key + "=" + (.value | tostring)' \
    "${manifest}" > "${CLOSURE_LABELS_FILE}.selector"

  closure_reachable="false"
  closure_j=0
  while [[ ${closure_j} -lt ${CLOSURE_WORKLOADS} ]]; do
    closure_satisfied="true"
    while IFS= read -r closure_pair; do
      [[ -z "${closure_pair}" ]] && continue
      if ! grep -qxF "${closure_pair}" "${CLOSURE_FINAL_INDEX}/${closure_j}.labels"; then
        closure_satisfied="false"
        break
      fi
    done < "${CLOSURE_LABELS_FILE}.selector"
    if [[ "${closure_satisfied}" == "true" ]]; then
      closure_reachable="true"
      break
    fi
    closure_j=$((closure_j + 1))
  done

  if [[ "${closure_reachable}" == "true" ]]; then
    log "  ✓ ${closure_rel} (Service ${closure_name} selects a workload)"
  else
    log_error "  ✗ ${closure_rel}: Service ${closure_name} selector matches no workload in this chart, so it would route to nothing"
    CLOSURE_ERRORS=$((CLOSURE_ERRORS + 1))
  fi
done < <(find "${ANNOTATED_DIR}" -name '*.yaml' -type f)

if [[ ${CLOSURE_ERRORS} -gt 0 ]]; then
  log_error "${CLOSURE_ERRORS} workload label-closure error(s)"
  log_error "Pod template 'app' and 'app.kubernetes.io/name' must equal the workload's"
  log_error "metadata.name - those labels reach the ReplicaSets and Pods and identify"
  log_error "ownership - and every selector must still match the pods it targets."
  log_error "Enable fullnameOverride to have Kaptain normalise this automatically, or"
  log_error "align the chart yourself with yqTransform."
  exit 1
fi

cp -r "${ANNOTATED_DIR}"/. "${VALIDATED_DIR}/"

log ""
log "Helm render and process complete. Output in ${VALIDATED_DIR}/"

# ==========================================================================
# Stage 9: Image Retags
# ==========================================================================

if [[ -n "${IMAGE_RETAGS_JSON}" && "${IMAGE_RETAGS_JSON}" != "null" && "${IMAGE_RETAGS_JSON}" != "[]" ]]; then
  log ""
  log "Stage 9: Retagging images..."

  DOCKER_TAG="${DOCKER_TAG:?DOCKER_TAG is required for image retags}"
  DOCKER_IMAGE_NAME="${DOCKER_IMAGE_NAME:?DOCKER_IMAGE_NAME is required for image retags}"
  DOCKER_IMAGE_NAME_OVERRIDE="${DOCKER_IMAGE_NAME_OVERRIDE:-}"

  RETAG_COUNT=$(echo "${IMAGE_RETAGS_JSON}" | jq length)
  ADDITIONAL_TOKENS_DIR="${OUTPUT_SUB_PATH}/manifests/additional-tokens"
  mkdir -p "${ADDITIONAL_TOKENS_DIR}"

  for ((i = 0; i < RETAG_COUNT; i++)); do
    SOURCE_IMAGE_URI=$(echo "${IMAGE_RETAGS_JSON}" | jq -r ".[${i}].sourceImageUri")
    TAG_SUFFIX=$(echo "${IMAGE_RETAGS_JSON}" | jq -r ".[${i}].tagSuffix")

    # Parse sourceImageUri into registry, image name, and tag
    # Format: registry/image/path:tag
    SOURCE_TAG="${SOURCE_IMAGE_URI##*:}"
    SOURCE_REGISTRY_AND_IMAGE="${SOURCE_IMAGE_URI%:*}"
    SOURCE_REGISTRY="${SOURCE_REGISTRY_AND_IMAGE%%/*}"
    SOURCE_IMAGE_NAME="${SOURCE_REGISTRY_AND_IMAGE#*/}"

    log "  Retag $((i + 1))/${RETAG_COUNT}: ${SOURCE_IMAGE_URI} -> tag suffix: ${TAG_SUFFIX}"

    DOCKER_SOURCE_REGISTRY="${SOURCE_REGISTRY}" \
    DOCKER_SOURCE_IMAGE_NAME="${SOURCE_IMAGE_NAME}" \
    DOCKER_SOURCE_TAG="${SOURCE_TAG}" \
    DOCKER_RETAG_TAG_SUFFIX="${TAG_SUFFIX}" \
      "${SCRIPT_DIR}/docker-build-retag"

    # Write per-suffix DockerTag token for later substitution
    # e.g. tagSuffix "gateway" -> canonical DOCKER_TAG_GATEWAY -> DockerTagGateway (PascalCase)
    SUFFIX_UPPER=$(echo "${TAG_SUFFIX}" | tr '-' '_' | tr '[:lower:]' '[:upper:]')
    TOKEN_NAME=$(convert_token_name "${TOKEN_NAME_STYLE}" "DOCKER_TAG_${SUFFIX_UPPER}")
    TOKEN_VALUE="${DOCKER_TAG}-${TAG_SUFFIX}"

    log "  Writing additional token: ${TOKEN_NAME}=${TOKEN_VALUE}"
    printf '%s' "${TOKEN_VALUE}" > "${ADDITIONAL_TOKENS_DIR}/${TOKEN_NAME}"
  done

  # Ensure DockerImageName survives the override step
  # Prefer inbound override from KaptainPM.yaml if set, otherwise use build-time value
  if [[ -n "${DOCKER_IMAGE_NAME_OVERRIDE}" ]]; then
    output_var "DOCKER_IMAGE_NAME_OVERRIDE" "${DOCKER_IMAGE_NAME_OVERRIDE}"
  else
    output_var "DOCKER_IMAGE_NAME_OVERRIDE" "${DOCKER_IMAGE_NAME}"
  fi
fi
